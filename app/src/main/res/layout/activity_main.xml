<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#101820">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SECRET CALCULATOR"
        android:textColor="#00E5FF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="12dp"/>

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#202C39"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:gravity="end|center_vertical"
        android:padding="16dp"
        android:singleLine="true"/>

    <GridLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="4"
        android:rowCount="5"
        android:paddingTop="12dp">

        <Button android:id="@+id/b7" android:text="7" style="@style/CalcButton"/>
        <Button android:id="@+id/b8" android:text="8" style="@style/CalcButton"/>
        <Button android:id="@+id/b9" android:text="9" style="@style/CalcButton"/>
        <Button android:id="@+id/div" android:text="/" style="@style/CalcButton"/>

        <Button android:id="@+id/b4" android:text="4" style="@style/CalcButton"/>
        <Button android:id="@+id/b5" android:text="5" style="@style/CalcButton"/>
        <Button android:id="@+id/b6" android:text="6" style="@style/CalcButton"/>
        <Button android:id="@+id/mul" android:text="*" style="@style/CalcButton"/>

        <Button android:id="@+id/b1" android:text="1" style="@style/CalcButton"/>
        <Button android:id="@+id/b2" android:text="2" style="@style/CalcButton"/>
        <Button android:id="@+id/b3" android:text="3" style="@style/CalcButton"/>
        <Button android:id="@+id/minus" android:text="-" style="@style/CalcButton"/>

        <Button android:id="@+id/b0" android:text="0" style="@style/CalcButton"/>
        <Button android:id="@+id/dot" android:text="." style="@style/CalcButton"/>
        <Button android:id="@+id/clear" android:text="C" style="@style/CalcButton"/>
        <Button android:id="@+id/plus" android:text="+" style="@style/CalcButton"/>

        <Button
            android:id="@+id/equals"
            android:layout_columnSpan="4"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="="
            android:textSize="26sp"
            android:backgroundTint="#00A6C7"/>
    </GridLayout>
</LinearLayout>
